rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{roomCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.players.sente == request.auth.uid
        && request.resource.data.players.gote == null;
      allow update: if request.auth != null
        && (resource.data.players.sente == request.auth.uid
            || resource.data.players.gote == request.auth.uid
            || (resource.data.players.gote == null
                && request.resource.data.players.gote == request.auth.uid));
      allow delete: if false;
    }

    // 大会(リーグ戦/トーナメント)。カジュアル利用を想定し、参加・結果反映はログイン済みなら可。
    match /tournaments/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }
  }
}
